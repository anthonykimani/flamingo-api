# Service Config
SERVICE_NAME="Games Service"
NODE_ENV=development
PORT=3077

# Application config
APPLICATION_NAME="Flamingo Game"
APPLICATION_API_BASEURL="http://localhost:3077"
APPLICATION_API_KEY=""

# Frontend origin (CORS for HTTP + Socket.IO)
FRONTEND_URL="http://localhost:3000"

# Database config
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flamingo_game
DB_USER=postgres
DB_PASSWORD=changeme
DB_SSL=0

# OpenRouter API Key (AI quiz generation)
OPENROUTER_API_KEY=

# Blockchain config
# Active chain: base | base-sepolia | celo | celo-sepolia
CHAIN=celo-sepolia
# Backend signer key (no 0x prefix). MUST be rotated before any real deployment.
PRIVATE_KEY=

# Contract addresses per chain (only the CHAIN-selected pair is required)
BASE_FLAMINGO_ESCROW_ADDRESS=
BASE_USDC_ADDRESS=
BASE_SEPOLIA_FLAMINGO_ESCROW_ADDRESS=
BASE_SEPOLIA_USDC_ADDRESS=
CELO_FLAMINGO_ESCROW_ADDRESS=
CELO_USDC_ADDRESS=
CELO_SEPOLIA_FLAMINGO_ESCROW_ADDRESS=
CELO_SEPOLIA_USDC_ADDRESS=

# JWT config (must match identity service)
TOKEN_SECRET=change-me-in-production
TOKEN_ISSUER=flamingo-game
TOKEN_EXPIRY=86400
